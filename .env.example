# Ejemplo solamente. El worker lee el entorno; no carga este archivo.
ECOV_UDP_HOST=0.0.0.0
ECOV_UDP_PORT=4211
ECOV_UDP_DEVICE_ID=DEMO-IOT-01
# Marcadores NO válidos: sustituir localmente por claves compartidas (64 hex).
# No publicar valores reales ni guardar este archivo como credenciales.
ECOV_UDP_HMAC_KEY_HEX=CLAVE_HMAC_FICTICIA_REEMPLAZAR
ECOV_UDP_AEAD_KEY_HEX=CLAVE_AEAD_FICTICIA_REEMPLAZAR
