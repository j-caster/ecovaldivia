# Ejemplo solamente. El worker lee el entorno; no carga este archivo.
ECOV_UDP_HOST=0.0.0.0
ECOV_UDP_PORT=4211
ECOV_UDP_DEVICE_ID=DEMO-IOT-01
# Marcadores NO válidos: sustituir localmente por claves compartidas (64 hex).
# No publicar valores reales ni guardar este archivo como credenciales.
ECOV_UDP_HMAC_KEY_HEX=CLAVE_HMAC_FICTICIA_REEMPLAZAR
ECOV_UDP_AEAD_KEY_HEX=CLAVE_AEAD_FICTICIA_REEMPLAZAR

# --- Aplicación web ---
# Clave de sesión. Sin ella se genera una temporal y las sesiones caen al reiniciar.
SECRET_KEY=cambiar-por-una-clave-larga-y-secreta
# 1 solo con HTTPS (en Render: "1"; en local con HTTP: dejar en 0 o sin definir).
SESSION_COOKIE_SECURE=0
# Base de datos. Sin definir se usa SQLite en instance/ecovaldivia.db.
# En Render el Blueprint la inyecta desde la base Postgres del servicio.
# DATABASE_URL=postgresql://usuario:clave@host:5432/ecovaldivia

# --- Cámara en vivo (punto de demostración) ---
# URL RTSP cruda de la cámara del punto "Demostración — Las Ánimas".
# Sustituir por el valor real; no publicar credenciales reales en el repositorio.
ECOV_CAMARA_RTSP_URL=rtsp://USUARIO:CLAVE@192.168.1.26/live0
# Identificador del stream configurado en go2rtc (http://localhost:1984).
ECOV_CAMARA_STREAM_SRC=las_animas
# Origen del servidor de streaming (go2rtc). En producción: URL pública del túnel/proxy.
ECOV_CAMARA_STREAM_HOST=http://localhost:1984
